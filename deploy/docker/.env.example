# Docker images. The infrastructure tags are intentionally pinned.
NF_COMPOSE_PROJECT_NAME=nexusforever
NF_IMAGE=nexusforever-local:dev
NF_MYSQL_IMAGE=mysql:8.4.10
NF_RABBITMQ_IMAGE=rabbitmq:4.3.4-management

# Operator-supplied build-16042 assets. Use absolute host paths.
NF_TBL_PATH=/absolute/path/to/tbl
NF_MAP_PATH=/absolute/path/to/map

# Optional external NexusForever.WorldDatabase root. Leave empty to skip world
# content import while still applying schemas, account, and realm bootstrap.
NF_WORLD_SQL_PATH=

# Client-facing listeners. Bridge networking requires WorldServer's published
# listener to be reachable from AuthServer at NF_REALM_HOST as well as by the
# client. Limit these three ports with the host firewall when using 0.0.0.0.
NF_BIND_ADDRESS=0.0.0.0
NF_AUTH_PUBLIC_PORT=23115
NF_STS_PUBLIC_PORT=6600
NF_WORLD_PUBLIC_PORT=24000

# Realm 1 is the only realm created by this local topology. This must be an
# Usable unicast IPv4 address that AuthServer and the game client can reach.
# In bridge networking, 127.0.0.1 points at AuthServer and is not suitable.
NF_REALM_NAME=NexusForever
NF_REALM_HOST=CHANGE_ME_REACHABLE_HOST

# Fixed local service identities.
NF_MYSQL_USER=nexusforever
NF_RABBITMQ_USER=nexusforever
NF_ADMIN_USERNAME=nexusforever

# `scripts/nexusforever init` replaces every value below. Values are restricted
# to URL/connection-string-safe hexadecimal characters.
NF_MYSQL_ROOT_PASSWORD=CHANGE_ME_GENERATED_BY_INIT
NF_MYSQL_PASSWORD=CHANGE_ME_GENERATED_BY_INIT
NF_RABBITMQ_PASSWORD=CHANGE_ME_GENERATED_BY_INIT
NF_ACCOUNT_API_CREDENTIAL=CHANGE_ME_GENERATED_BY_INIT
NF_CHARACTER_API_CREDENTIAL=CHANGE_ME_GENERATED_BY_INIT
NF_ADMIN_PASSWORD=CHANGE_ME_GENERATED_BY_INIT

# Maximum time allowed for all singleton RabbitMQ workers to attach consumers.
NF_WORKER_READY_TIMEOUT_SECONDS=180
